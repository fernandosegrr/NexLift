{
  "name": "nexlift",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "node scripts/build-typescript.mjs client && npm run dev --workspace client",
    "dev:server": "node scripts/build-typescript.mjs server && npm run dev --workspace nexlift-server",
    "test": "node scripts/verify-monorepo.mjs",
    "test:client": "npm test --workspace client",
    "test:server": "npm test --workspace nexlift-server",
    "test:unit": "npm run test --workspaces --if-present",
    "test:monorepo": "node --test scripts/test/monorepo.test.mjs",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:shared": "npm run build --workspace @nexlift/shared",
    "build:client": "node scripts/build-typescript.mjs client && npm run build --workspace client",
    "build:server": "node scripts/build-typescript.mjs server && node scripts/check-server.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "check": "node scripts/check-project.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check:shared": "npm run check:shared --workspace client && npm run check:shared --workspace nexlift-server",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace client",
    "lint:tooling": "node scripts/check-tooling.mjs",
    "verify:monorepo": "node scripts/verify-monorepo.mjs",
    "build:typed": "node scripts/build-typescript.mjs",
    "check:generated": "node scripts/build-typescript.mjs check",
    "lint:typescript": "node scripts/lint-typescript.mjs",
    "check:typescript": "npm run typecheck && npm run check:generated && npm run lint:typescript",
    "test:typescript": "node --test scripts/test/typescript.test.mjs packages/shared/test/imports.test.mjs",
    "test:contracts": "node --test packages/shared/test/contracts.test.mjs scripts/test/contracts.test.mjs",
    "test:phase44": "node --test scripts/test/phase44.test.mjs",
    "test:performance:integration": "node server/test/run-performance-integration.mjs",
    "test:performance": "node --test scripts/test/training-performance.test.mjs",
    "test:training": "node --test scripts/test/training-characterization.test.mjs scripts/test/training-shared.test.mjs",
    "test:smart-loading": "node --test scripts/test/smart-loading.test.mjs",
    "test:smart-loading:integration": "node server/test/run-smart-loading-integration.mjs",
    "test:analysis": "node --test scripts/test/training-analysis.test.mjs",
    "test:analysis:integration": "node server/test/run-training-analysis-integration.mjs",
    "test:database:integration": "node server/test/run-phase6-integration.mjs",
    "dev:fastify": "node scripts/build-typescript.mjs server && npm run start:fastify --workspace nexlift-server",
    "test:backend": "node --test server/test/phase7-http.test.js server/test/phase7-notifications.test.js",
    "test:fastify:integration": "node server/test/run-phase7-integration.mjs",
    "test:fastify:offline": "node server/test/run-phase7-offline.mjs",
    "lint:backend": "node scripts/check-phase7.mjs",
    "audit:api": "node scripts/audit-backend.mjs",
    "test:frontend": "npm run test:frontend --workspace client && node --test scripts/test/frontend.test.mjs",
    "test:release": "node --test server/test/phase10-release.test.js",
    "test:release:integration": "node server/test/run-phase10-integration.mjs",
    "test:release:browser": "node --test scripts/test/release-browser.test.mjs",
    "test:release:docker": "node scripts/docker-release-rehearsal.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "lint:release": "node scripts/lint-release.mjs",
    "release:preflight": "node server/deploy/release-preflight.mjs",
    "release:start": "node server/deploy/release-http.mjs",
    "release:migrate:disposable": "node server/deploy/release-migrate.mjs"
  },
  "devDependencies": {
    "@nexlift/shared": "0.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3"
  }
}
