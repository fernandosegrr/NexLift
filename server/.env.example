# NexLift Backend Environment — plantilla. Copia a .env y rellena los valores reales.

# Obligatorias
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=disable"
JWT_SECRET=
PORT=3001
# NODE_ENV=production   # requerido en el deploy de EasyPanel; el server no arranca en
                         # producción sin JWT_SECRET definido (ver server/src/index.js)

# Web Push (Tarea 2) — opcionales. Genera un par con `npx web-push generate-vapid-keys`.
# Sin ellas, la app funciona igual: scheduleRestReminder queda en no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# LLM para deduplicación de ejercicios (Tarea 4) — opcional. Sin ella, el import cae
# al matching determinista (canonicalExerciseKey), sin romper nada.
OPENAI_API_KEY=

# Cloudinary — opcional. Si las 3 están definidas, avatar/fotos de progreso suben ahí
# en vez de a Catbox (más confiable, con SLA real). Sin ellas, sigue cayendo a Catbox
# como antes (ver uploadPhoto() en server/src/index.js). Sacar de tu dashboard de
# Cloudinary (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Retencion v4: limite de 14 por usuario, solo en el namespace users/ nuevo.
# Por defecto solo analiza candidatos; no elimina respaldos existentes/legacy.
# Activar la poda real requiere una decision operativa posterior al simulacro.
NEXLIFT_BACKUP_PRUNE_ENABLED=false
# Las CLI de recuperacion NO leen .env: definir su destino explicitamente al usar.
# NEXLIFT_RESTORE_DATABASE_URL=   # restore-backup.mjs
# NEXLIFT_RECOVERY_DATABASE_URL=  # postgres-recovery.mjs

# Fase 2.3: SOLO ensayo desechable, procedimiento alternativo no activado.
# No definir estas variables para activar migraciones en el despliegue actual.
# NODE_ENV=production
# NEXLIFT_INFRA_REHEARSAL=true
# NEXLIFT_RELEASE_DATABASE_URL=   # destino explicito; sin fallback a DATABASE_URL/.env
# JWT_SECRET=                   # aleatorio, al menos 32 caracteres en el ensayo
# PORT=3001                     # configurar el proxy al mismo puerto

# Fase 3.2: negociación offline, únicamente desarrollo/ensayo desechable.
# NODE_ENV=production bloquea esta capacidad incluso si esta flag vale true.
NEXLIFT_OFFLINE_SYNC_ENABLED=false
# Phase 3.4: isolated development/staging only; also requires offline sync enabled.
NEXLIFT_CONFLICT_RESOLUTION_ENABLED=false

# Phase 9: exact proxy addresses/CIDRs; empty = do not trust forwarding headers.
NEXLIFT_TRUSTED_PROXY_CIDRS=
# Non-production opt-in only; requires NEXLIFT_INFRA_REHEARSAL=true in Express.
NEXLIFT_WEB_SESSION_REHEARSAL=false
NEXLIFT_WEB_ORIGIN=
