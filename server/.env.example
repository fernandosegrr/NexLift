# NexLift Backend Environment — plantilla. Copia a .env y rellena los valores reales.

# Obligatorias
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=disable"
JWT_SECRET=
PORT=3001
# NODE_ENV=production   # requerido en el deploy de EasyPanel; el server no arranca en
                         # producción sin JWT_SECRET definido (ver server/src/index.js)

# Web Push (Tarea 2) — opcionales. Genera un par con `npx web-push generate-vapid-keys`.
# Sin ellas, la app funciona igual: scheduleRestReminder queda en no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# LLM para deduplicación de ejercicios (Tarea 4) — opcional. Sin ella, el import cae
# al matching determinista (canonicalExerciseKey), sin romper nada.
OPENAI_API_KEY=

# Cloudinary — opcional. Si las 3 están definidas, avatar/fotos de progreso suben ahí
# en vez de a Catbox (más confiable, con SLA real). Sin ellas, sigue cayendo a Catbox
# como antes (ver uploadPhoto() en server/src/index.js). Sacar de tu dashboard de
# Cloudinary (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
