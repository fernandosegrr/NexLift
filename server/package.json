{
  "name": "nexlift-server",
  "version": "1.0.0",
  "description": "NexLift Gym PWA Backend",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test src/logic.test.js src/services/aiRoutineService.test.js",
    "test:integration": "node test/run-routine-integration.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test:backup": "node --test test/backup-cloud.test.js",
    "test:backup:integration": "node test/run-backup-integration.mjs",
    "test:import": "node --test test/routine-import-contract.test.js",
    "test:import:integration": "node test/run-import-integration.mjs",
    "test:workout:baseline": "node test/run-workout-integration.mjs --baseline",
    "test:workout:integration": "node test/run-workout-integration.mjs",
    "test:schema:audit": "node test/run-schema-audit.mjs",
    "test:baseline": "node test/run-baseline-integration.mjs",
    "test:infra": "node --test test/infra-auth.test.js test/infra-operations.test.js",
    "test:infra:integration": "node test/run-infrastructure-integration.mjs",
    "verify:node24": "node test/verify-node24.mjs",
    "test:staging": "node --test test/staging.test.js",
    "test:staging:integration": "node test/run-staging-integration.mjs",
    "verify:staging": "node test/verify-staging.mjs",
    "test:operations": "node --test test/operation-contract.test.js",
    "test:operations:integration": "node test/run-operation-integration.mjs",
    "verify:operations": "node test/verify-operations.mjs",
    "test:sync:integration": "node test/run-sync-integration.mjs",
    "verify:sync": "node test/verify-sync.mjs",
    "test:storage:integration": "node test/run-storage-integration.mjs",
    "verify:storage": "node test/verify-storage.mjs",
    "staging:create": "node staging/local.mjs create",
    "staging:up": "node staging/local.mjs up",
    "staging:status": "node staging/local.mjs status",
    "staging:stop": "node staging/local.mjs stop",
    "staging:backup": "node staging/local.mjs backup",
    "staging:inspect": "node staging/local.mjs inspect",
    "test:conflicts:integration": "node test/run-conflict-integration.mjs",
    "verify:conflicts": "node test/verify-conflicts.mjs",
    "test:offline:integration": "node test/run-stabilization-integration.mjs",
    "test:offline:sw": "node --test test/stabilization-sw.test.js",
    "verify:offline": "node test/verify-stabilization.mjs",
    "check:shared": "node ../scripts/check-shared.mjs server",
    "typecheck": "tsc --project tsconfig.json",
    "build:typed": "node ../scripts/build-typescript.mjs server",
    "build": "npm run build:typed && node ../scripts/check-server.mjs",
    "test:typescript:dev": "node test/run-typescript-dev.mjs",
    "start:fastify": "node src/entrypoints/fastify.mjs",
    "dev:fastify": "npm run build:typed && node --watch src/entrypoints/fastify.mjs"
  },
  "dependencies": {
    "@fastify/compress": "9.2.2",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.7",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "etag": "1.8.1",
    "express": "^4.18.2",
    "fastify": "5.12.7",
    "form-data": "^4.0.5",
    "fresh": "0.5.2",
    "helmet": "^8.2.0",
    "iconv-lite": "0.4.24",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^6.45.0",
    "qs": "6.16.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prisma": "6.19.3"
  }
}
