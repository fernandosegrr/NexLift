generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USUARIO ====================

model User {
  id            String    @id @default(cuid())
  
  // Credenciales
  username      String    @unique
  email         String    @unique
  passwordHash  String
  
  // Perfil
  firstName     String
  lastName      String
  phone         String?
  birthDate     DateTime?
  avatarUrl     String?   // Foto de perfil en Catbox
  
  // Recuperación (pregunta de seguridad)
  securityQuestion  String?
  securityAnswerHash String?

  // Estado
  isActive      Boolean   @default(true)

  // Revocación de sesión: cambiar contraseña o pregunta de seguridad la incrementa,
  // invalidando todos los JWT emitidos antes de ese momento (authMiddleware la
  // compara contra la que trae el token). Los tokens duran 365 días y no hay otro
  // mecanismo para revocar uno filtrado.
  tokenVersion  Int       @default(0)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?
  
  // Relaciones
  routines          Routine[]
  bodyLogs          BodyLog[]
  restLogs          RestLog[]
  personalRecords   PersonalRecord[]
  goals             Goal[]
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([username])
}

// ==================== RUTINAS ====================

model Routine {
  id          String       @id @default(cuid())
  name        String
  description String?
  isActive    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  days        RoutineDay[]
  
  // Relación con usuario (opcional para migración)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model RoutineDay {
  id          String     @id @default(cuid())
  dayName     String
  isRestDay   Boolean    @default(false)
  order       Int        @default(0)
  routineId   String
  routine     Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
}

model Exercise {
  id           String       @id @default(cuid())
  name         String
  muscleGroup  String?
  targetSets   Int
  targetReps   String
  restSeconds  Int?
  note         String?
  order        Int          @default(0)
  isUnilateral Boolean      @default(false)
  routineDayId String
  routineDay   RoutineDay   @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  workoutLogs  WorkoutLog[]

  @@index([routineDayId])
  @@index([name])
}

// ==================== WORKOUTS ====================

model WorkoutLog {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())
  exerciseId  String
  // onDelete explícito (antes implícito vía default de Postgres): un ejercicio con
  // historial NUNCA se borra de verdad (ver getRecycleBinDay/archivo en index.js) —
  // Restrict lo hace imposible también a nivel de base de datos, en vez de depender
  // de que nadie "corrija" una relación que parecía incompleta agregando Cascade.
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets        SetLog[]
  notes       String?

  @@index([exerciseId])
  @@index([date])
}

model SetLog {
  id           String     @id @default(cuid())
  setNumber    Int
  weight       Float
  reps         Int
  rpe          Int?
  completed    Boolean    @default(true)
  weightRight  Float?
  repsRight    Int?
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
}

// ==================== PERSONAL RECORDS ====================

model PersonalRecord {
  id           String   @id @default(cuid())
  exerciseName String
  weight       Float
  reps         Int
  estimated1RM Float?
  date         DateTime @default(now())
  
  // Relación con usuario (opcional para migración)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([exerciseName])
  @@index([userId])
}

// ==================== DESCANSO ====================

model RestLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  note      String?
  
  // Relación con usuario (opcional para migración)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// ==================== BODY TRACKING ====================

model BodyLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  weight    Float?
  photoUrl  String?  // URL de Catbox (antes era base64)
  note      String?
  
  // Composición corporal (báscula inteligente)
  bmi         Float?
  bodyFat     Float?
  muscleMass  Float?
  bmr         Float?
  bodyWater   Float?
  visceralFat Float?
  boneMass    Float?
  protein     Float?
  
  createdAt DateTime @default(now())
  
  // Relación con usuario (opcional para migración)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([date])
  @@index([userId])
}

// ==================== GOALS ====================

model Goal {
  id           String    @id @default(cuid())
  exerciseName String
  muscleGroup  String?
  targetWeight Float
  targetReps   Int
  createdAt    DateTime  @default(now())
  achievedAt   DateTime?
  
  // Manual data (fallback when no workout history)
  // Manual data (fallback when no workout history)
  currentOneRepMax   Float?   // Max weight for 1 rep
  currentEightRepMax Float?   // Max weight for 8 reps
  experienceLevel    String?  // 'beginner', 'intermediate', 'advanced'
  frequencyPerWeek   Int?     // How many times per week training this exercise
  completedWeeks     Int[]    // Array of completed week numbers (1-indexed)
  
  // Relación con usuario
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== PUSH NOTIFICATIONS ====================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
