# Deny by default. Both Dockerfiles copy only these runtime/build inputs.
**
!Dockerfile
!Dockerfile.rehearsal
!Dockerfile.staging
!Dockerfile.release
!.dockerignore
!package.json
!package-lock.json
!.npmrc
!packages/
!packages/shared/
!packages/shared/package.json
!packages/shared/src/
!packages/shared/src/**
!packages/shared/tsconfig*.json
!configs/
!configs/*.json
!scripts/
!scripts/prisma-generate.mjs
!scripts/build-typescript.mjs
!scripts/check-server.mjs
!client/
!client/package.json
!client/package-lock.json
!client/index.html
!client/vite.config.js
!client/tsconfig*.json
!client/public/
!client/public/**
!client/src/
!client/src/**
!server/
!server/package.json
!server/package-lock.json
!server/tsconfig*.json
!server/src/
!server/src/**
!server/prisma/
!server/prisma/schema.prisma
!server/prisma/migrations/
!server/prisma/migrations/**
!server/deploy/
!server/deploy/*.js
!server/deploy/*.mjs
!server/deploy/operations-catalog.json
!server/staging/
!server/staging/container.mjs
!server/staging/egress.mjs
!server/audit/
!server/audit/postgresql/
!server/audit/postgresql/audit-tools.mjs
!server/audit/postgresql/catalog.sql
!server/audit/postgresql/declared-catalog.json
!server/audit/database/
!server/audit/database/declared-catalog.json
# Final exclusions override allow rules, including inside allowed source dirs.
**/node_modules
**/dist
**/.git
**/.env*
**/*backup*
**/*Backup*
# Runtime backup implementation is required (never bundle actual archives).
!server/src/services/backup*.js
!server/src/services/postgresBackup.js
!server/src/services/postgresSystemBackup.js
!server/src/routes/backup.js
**/*.test.*
**/*.dump
**/*.sql.gz
**/*.zip
**/*.tar
**/*.gz
**/*.bak
**/*.pem
**/*.key
**/*.p12
**/*.pgpass
**/*.pg_service.conf
**/users.safe.json
**/system-manifest.json
**/manifest.json
!client/public/manifest.json
**/pg_service.conf
**/.pgpass
**/secrets*
**/credentials*
**/*.pfx
**/*.sqlite*
**/*.db
**/*.private
**/*.private.*
