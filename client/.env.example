# Opt-in only for a verified disposable development/rehearsal backend.
# Production remains disabled by default. No legacy fallback when enabled.
VITE_WORKOUT_OPERATIONS_ENABLED=false
# IndexedDB requires BOTH opt-ins; keep false for production.
VITE_INDEXEDDB_ENABLED=false
# Conflict UI and partial resolutions require both previous opt-ins and server capability.
VITE_CONFLICT_RESOLUTION_ENABLED=false
