# Future Prisma migrations must be versioned (Phase 2.1 preparation).
# No migration history is activated by this change.

# Local recovery archives and connection service files can contain secrets.
*.dump
*.pg_service.conf

# Runtime secrets and local exports (templates remain versioned).
**/.env*
!**/.env.example
*.pgpass
*.sql.gz
*.backup
*.bak
*.pem
*.key

# Staging credentials, snapshots and sensitive source manifests stay local.
*.private
*.private.*
**/postgres-data/
**/compose-private/

client/build/

# Publication: retain local trial diagnostics without publishing temporary artifacts.
server/audit/**/attempts/
server/audit/**/*development*
